---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { byline, formatDate, getPosts } from '../lib/posts';
import heroImage from '../assets/images/site/odin_pheasant_hunt.jpg';

const recent = [...(await getPosts('bookshelf')), ...(await getPosts('journal'))]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  <section class="hero">
    <div class="intro">
      <h1>Product Manager & Outdoorsman.</h1>
      <p>
        I'm Fisher, a product manager based in Boise, Idaho. I use this site to share the niche software projects that
        I'm building for my own personal use.
      </p>
      <p>
        When I'm not building products professionally, or for fun, I'm usually out on a river or in the mountains;
        sometimes holed-up in my study. I share some of my (non-AI) writing about these topics and more in my
        sportsman's journal and on the bookshelf.
      </p>
      <p>
      Thanks for visiting!
      </p>
    </div>
    <Image src={heroImage} alt="Fisher kneeling with Odin along the river after a hunt" width={720} class="hero-image" />
  </section>

  <section>
    <h2 class="section-title">What I've Been Working On Lately</h2>
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section>
    <h2 class="section-title">My Recent Writing</h2>
    <ul class="recent">
      {
        recent.map((post) => (
          <li>
            <a href={`/${post.collection}/${post.id}/`}>
              <span class="kind">{post.collection === 'journal' ? 'Journal' : 'Bookshelf'}</span>
              <span class="title">{post.data.title}</span>
              <span class="meta">
                {byline(post)} · {formatDate(post.data.date)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  section + section {
    margin-top: 2.5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 1.25rem;
  }

  .intro p {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .hero-image {
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .recent {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .recent a {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .recent a:hover .title {
    color: var(--accent);
  }

  .kind {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .title {
    font-family: var(--display);
    font-weight: 600;
  }

  .recent .meta {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-image {
      height: 320px;
    }

    .recent a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
