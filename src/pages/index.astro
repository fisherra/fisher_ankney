---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { byline, formatDate, getPosts } from '../lib/posts';
import heroImage from '../assets/images/site/chase_pic.png';

const recent = [...(await getPosts('bookshelf')), ...(await getPosts('journal'))]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  <section class="hero">
    <div class="intro">
      <h1>Product manager, building with AI.</h1>
      <p>
        I'm Fisher, a product manager in Boise, Idaho. I'm learning to build software with AI by shipping
        small, real products in public, along with the PRDs, backlogs, and trade-offs behind them.
      </p>
      <p>
        Off the clock I'm usually on a river or in the chukar hills with my bird dog. I write about that in
        the journal, and about what I'm reading on the bookshelf.
      </p>
      <div class="actions">
        <a class="button" href="/projects/">See the projects</a>
        <a class="button secondary" href="/about/">About me</a>
      </div>
    </div>
    <Image src={heroImage} alt="Fisher kneeling with Chase, a Brittany, in the Idaho sagebrush hills" width={720} class="hero-image" />
  </section>

  <section>
    <h2 class="section-title">What I'm building</h2>
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section>
    <h2 class="section-title">Recent writing</h2>
    <ul class="recent">
      {
        recent.map((post) => (
          <li>
            <a href={`/${post.collection}/${post.id}/`}>
              <span class="kind">{post.collection === 'journal' ? 'Journal' : 'Bookshelf'}</span>
              <span class="title">{post.data.title}</span>
              <span class="meta">
                {byline(post)} · {formatDate(post.data.date)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  section + section {
    margin-top: 3.5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 1.25rem;
  }

  .intro p {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .button:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .button.secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .button.secondary:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .hero-image {
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .recent {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .recent a {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .recent a:hover .title {
    color: var(--accent);
  }

  .kind {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .title {
    font-weight: 600;
  }

  .recent .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-image {
      height: 320px;
    }

    .recent a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
