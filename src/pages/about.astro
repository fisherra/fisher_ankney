---
import Base from '../layouts/Base.astro';

const roles = [
  {
    org: 'CCT',
    title: 'Senior Product Manager',
    logo: '/logos/cct.png',
    dates: '2026 — Present',
    note: 'Own product strategy for Insight Cash, the cage, vault, and revenue-audit product in CCT’s Casino Insight platform. Shaping how we use AI-assisted development while migrating a legacy WinForms application to a multi-tenant web app on AWS.',
  },
  {
    org: 'DoubleVerify',
    title: 'Product Manager',
    logo: '/logos/doubleverify.svg',
    dates: '2023 — 2026',
    note: 'Owned the strategy for a four-product advertising suite, grown from $39M to $50M in ARR. Took Attention Measurement for Marketplaces from first discovery call to GA.',
  },
  {
    org: 'Oracle',
    title: 'Product Manager',
    logo: '/logos/oracle.png',
    dates: '2022 — 2023',
    note: 'Replaced seven disjointed internal configuration tools with a single self-service interface, saving roughly 120 FTE hours a month.',
  },
  {
    org: 'Gravitate',
    title: 'Product Manager',
    logo: '/logos/gravitate.png',
    dates: '2020 — 2022',
    note: 'First PM at a pre-seed startup; $0 to $1M+ ARR in under two years. Also the ML subject-matter expert behind its fuel demand forecasting and best-price purchasing algorithms.',
  },
];
---

<Base
  title="About"
  description="Fisher Ankney is a product manager in Boise, Idaho: a statistician by training and an outdoorsman by upbringing."
>
  <div class="page-intro title-only">
    <div class="page-title">
      <h1>About</h1>
    </div>
  </div>

  <div class="prose">
    <p>
      I grew up in Grayling, in northern Michigan, where my parents raised me to hunt and fish. The town has a deep
      outdoors heritage: Fred Bear opened his archery shop there, Trout Unlimited was founded there, and the
      ubiquitous Adams dry fly was invented a few miles down the road.
    </p>
    <p>
      The day after I graduated high school, I moved to Colorado. In Fort Collins I studied geology at Colorado State
      and spent two years as a data analyst with the U.S. Geological Survey, working in the Colorado Rockies. That
      work turned me toward statistics, which took me to Oklahoma State for a master's degree. I taught introductory
      statistics there, learned a great deal, and made the jump into tech.
    </p>
    <p>
      In early 2022 I moved to Boise, which I now call home. Since then I've managed a range of technical products,
      from advertising measurement to casino finance. Today I'm a Senior Product Manager at CCT, where I own a
      financial operations and audit product.
    </p>
  </div>

  <section class="timeline-wrap">
    <h2 class="section-title">Where I've worked</h2>
    <ol class="timeline">
      {
        roles.map((role) => (
          <li>
            <span class="logo" aria-hidden="true">
              <img src={role.logo} alt="" loading="lazy" decoding="async" />
            </span>
            <div class="role-body">
              <div class="role-head">
                <span class="org">{role.org}</span>
                <span class="dates">{role.dates}</span>
              </div>
              <p class="role-title">{role.title}</p>
              <p class="role-note">{role.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="prose closing">
    <p>
      I'm always open to new opportunities. My full resume is below, and the
      <a href="/contact/">contact form</a> is the best way to get in touch.
    </p>
    <p class="resume-line">
      <a class="button" href="/fisher-ankney-resume.pdf" download>Download my resume (PDF)</a>
    </p>
  </div>
</Base>

<style>
  .resume-line {
    margin-top: 1.25rem;
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .button:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .timeline-wrap {
    max-width: var(--column);
    margin: 3rem auto 0;
  }

  /* Same width and gap above as the work section, which has no rule over it either. */
  .closing {
    max-width: var(--column);
    margin-top: 3rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: 0.15rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .logo img {
    max-width: 34px;
    max-height: 34px;
    object-fit: contain;
    filter: grayscale(1) contrast(0.85) opacity(0.78);
    transition: filter 0.2s ease;
  }

  .timeline li:hover .logo img {
    filter: none;
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .org {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .dates {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
  }

  .role-title {
    margin: 0.1rem 0 0.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rust);
  }

  .role-note {
    margin: 0;
    font-size: 1.025rem;
  }

</style>
