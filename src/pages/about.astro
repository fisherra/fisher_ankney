---
import Base from '../layouts/Base.astro';

const roles = [
  {
    org: 'CCT',
    logo: '/logos/cct.png',
    url: 'https://cct.io/insight-cash/',
    dates: '2026 — Present',
    note: 'I own Insight Cash, an enterprise solution for casinos that touches all-things-cash.'  },
  {
    org: 'DoubleVerify',
    logo: '/logos/doubleverify.svg',
    url: 'https://doubleverify.com/capabilities-performance/',
    dates: '2023 — 2026',
    note: 'I owned the performance targeting products for programmatic advertising on the open web.',
  },
  {
    org: 'Oracle',
    logo: '/logos/oracle.png',
    // Oracle Advertising (the business this role was part of) has since been discontinued - link to Oracle's
    // homepage rather than a defunct product page.
    url: 'https://www.oracle.com/',
    dates: '2022 — 2023',
    note: 'I owned platformizing a set of internal ad measurement tagging tools to enable client self-service.',
  },
  {
    org: 'Gravitate',
    logo: '/logos/gravitate.png',
    url: 'https://gravitate.energy/',
    dates: '2020 — 2022',
    note: 'I owned representing the customer to enable the product to go from 0 to 1 and secure PMF.',
  },
];
---

<Base
  title="About"
  description="Fisher Ankney is a product manager and outdoorsman based in Boise, Idaho"
>
  <div class="page-intro title-only">
    <div class="page-title">
      <h1>About</h1>
    </div>
  </div>

  <div class="prose">
    <p>
      I grew up in Grayling, Michigan - a small town with deep outdoors heritage. It's where Fred Bear opened up his archery shop,
      where Trout Unlimited was founded, and the Adams dry fly was invented. I am forever grateful to my parents for instilling in me my passion 
      for reading, solitude, and the outdoors during this time. 
    </p>
    <p>
      The day after I graduated high school, I moved to Fort Collins, Colorado. The Colorado Rockies were a wonderful place to study geology
      and work for the US Geological Survey. Through this work, I became interested in formal statistical analysis and scientific experiment design, so I moved to Oklahoma for additional education.
    </p>
    <p>
      After graduating from OSU with an MS in Statistics, I started my career in technology and moved to Boise, Idaho. I've been working remotely from Boise as a PM ever since.  
    </p>
  </div>

  <section class="timeline-wrap">
    <h2 class="section-title">Where I've Built Great Products</h2>
    <ol class="timeline">
      {
        roles.map((role) => (
          <li>
            <a class="logo" href={role.url} target="_blank" rel="noopener noreferrer" aria-label={`${role.org} website`}>
              <img src={role.logo} alt="" loading="lazy" decoding="async" />
            </a>
            <div class="role-body">
              <p class="role-line">
                <span class="org">{role.org}</span> — {role.note}
              </p>
              <span class="dates">{role.dates}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="prose closing">
    <p>
      My full resume is linked below, I'm always open to discussing new opportunities and making new connections.
      Please reach out with any questions, comments or feedback using the contact form. Thanks!
    </p>
    <p class="resume-line">
      <a class="button" href="/fisher-ankney-resume.pdf" download>Download my resume (PDF)</a>
    </p>
  </div>
</Base>

<style>
  .resume-line {
    margin-top: 1.25rem;
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .button:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .timeline-wrap {
    max-width: var(--column);
    margin: 3rem auto 0;
  }

  /* Same width and gap above as the work section, which has no rule over it either. */
  .closing {
    max-width: var(--column);
    margin-top: 3rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 60px 1fr;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .logo:hover {
    border-color: var(--accent);
  }

  .logo:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .logo img {
    max-width: 44px;
    max-height: 44px;
    object-fit: contain;
    filter: grayscale(1) contrast(0.85) opacity(0.78);
    transition: filter 0.2s ease;
  }

  .timeline li:hover .logo img {
    filter: none;
  }

  .role-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.25rem;
  }

  .role-line {
    margin: 0;
    flex: 1 1 320px;
    min-width: 0;
    font-size: 1.025rem;
  }

  .org {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .dates {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
  }

</style>
