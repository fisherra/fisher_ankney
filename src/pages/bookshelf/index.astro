---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import SortFilter from '../../components/SortFilter.astro';
import { getPosts } from '../../lib/posts';
import type { SortField } from '../../lib/sort';

const posts = await getPosts('bookshelf');

const fields: SortField[] = [
  { value: 'read', label: 'Date read', desc: 'Recently read first', asc: 'Read earliest first', defaultDir: 'desc' },
  { value: 'rating', label: 'Rating', desc: 'Highest rated first', asc: 'Lowest rated first', defaultDir: 'desc' },
  { value: 'title', label: 'Title', asc: 'Title A–Z', desc: 'Title Z–A', defaultDir: 'asc', text: true },
  {
    value: 'published',
    label: 'Date published',
    asc: 'Published oldest first',
    desc: 'Published newest first',
    defaultDir: 'asc',
  },
];

const categories = (['Outdoors', 'Literature', 'History'] as const).map((name) => ({
  name,
  count: posts.filter((p) => p.data.category === name).length,
}));
---

<Base title="My Bookshelf" description="Book reviews from Fisher Ankney: history, the outdoors, and more.">
  <div class="page-intro">
    <div class="page-title">
      <h1>My Bookshelf</h1>
    </div>
    <p>Notes and reviews on what I'm reading, mostly history and the outdoors, sometimes further afield.</p>
  </div>

  <SortFilter storageKey="bookshelf" fields={fields} categories={categories} total={posts.length} noun="books" />

  <PostList posts={posts} />
</Base>
