---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<Base title="Projects" description="Products Fisher Ankney is building with AI.">
  <div class="page-intro">
    <div class="page-title">
      <h1>Projects</h1>
    </div>
    <p>
      Here are some projects I have been building out to test the latest AI-DLC workflows and tech. Each of these
      projects is personally useful, but more so they allow me to play PM without customer &amp; business
      constraints! Feel free to take a look; maybe they'll be of some use to you.
    </p>
  </div>
  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>

<style>
  .grid {
    max-width: var(--column);
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }
</style>
