---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import SortFilter from '../../components/SortFilter.astro';
import { getPosts } from '../../lib/posts';
import type { SortField } from '../../lib/sort';

const posts = await getPosts('journal');

const fields: SortField[] = [
  { value: 'date', label: 'Date published', desc: 'Newest first', asc: 'Oldest first', defaultDir: 'desc' },
];

const categories = (['Report', 'Essay', 'Review'] as const).map((name) => ({
  name,
  count: posts.filter((p) => p.data.category === name).length,
}));
---

<Base title="Sportsman's Journal" description="Quarterly field reports from hunting and fishing across Idaho.">
  <div class="page-intro">
    <div class="page-title">
      <h1>Sportsman's Journal</h1>
    </div>
    <p>
      My (non-AI) notes on a range of topics, all related to the outdoors. Hunting and fishing field
      reports are usually grouped up by season. Articles, essays and reviews of all lengths on different
      techniques, gear, etc.
    </p>
  </div>

  <SortFilter
    storageKey="journal"
    fields={fields}
    categories={categories}
    total={posts.length}
    noun="entries"
  />

  <PostList posts={posts} />
</Base>
