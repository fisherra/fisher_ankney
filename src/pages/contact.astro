---
import Base from '../layouts/Base.astro';

// Web3Forms access keys are meant to be public in client-side HTML, so this is
// safe to commit. Manage the key at https://web3forms.com.
const accessKey = '6549327c-02aa-42a5-b1bc-b2b3e14008c2';
---

<Base title="Contact" description="Get in touch with Fisher Ankney.">
  <div class="page-intro">
    <h1>Contact</h1>
    <p>
      If you're building something where the measurement is the hard part, I'd like to hear about it. Leave a
      note below and I'll get back to you.
    </p>
  </div>

  <div class="contact-body">
    <h2 class="section-title">Send a note</h2>

    <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="New message from fisherankney.com" />
      <input type="hidden" name="from_name" value="fisherankney.com" />
      <!-- Honeypot: real people leave this unchecked, bots tend not to. -->
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

      <div class="row">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="7" required></textarea>
      </div>

      <div class="actions">
        <button type="submit">Send note</button>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
      </div>
    </form>

    <p class="direct">
      Or reach me directly via email to <a href="mailto:fisherankney@gmail.com">fisherankney@gmail.com</a>.
    </p>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('.form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  // Without JS the form still posts natively to Web3Forms; this just keeps
  // people on the page and gives them an inline confirmation.
  form?.addEventListener('submit', async (event) => {
    if (!status || !button) return;
    event.preventDefault();

    button.disabled = true;
    button.textContent = 'Sending…';
    status.hidden = true;
    status.classList.remove('is-error', 'is-success');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message ?? 'Something went wrong.');
      }

      form.reset();
      status.textContent = "Thanks — your note is on its way.";
      status.classList.add('is-success');
    } catch (error) {
      status.textContent = 'That didn’t send. Please email me directly.';
      status.classList.add('is-error');
    } finally {
      status.hidden = false;
      button.disabled = false;
      button.textContent = 'Send note';
    }
  });
</script>

<style>
  .contact-body {
    max-width: var(--content);
    margin: 0 auto;
  }

  .section-title {
    margin-top: 0;
  }

  .direct {
    margin: 2rem 0 0;
    font-size: 1.05rem;
  }

  .botcheck {
    display: none;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    margin-bottom: 1.25rem;
  }

  label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  input[type='text'],
  input[type='email'],
  textarea {
    display: block;
    width: 100%;
    padding: 0.65rem 0.8rem;
    font-family: var(--font);
    font-size: 1.05rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input[type='text']:focus,
  input[type='email']:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  button {
    padding: 0.65rem 1.4rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
  }

  button:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  button:disabled {
    opacity: 0.65;
    cursor: default;
  }

  .form-status {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .form-status[hidden] {
    display: none;
  }

  .form-status.is-error {
    color: var(--rust);
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
