---
import { Image } from 'astro:assets';
import Stars from './Stars.astro';
import { byline, formatDate, formatYear, sortKey, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li
        data-date={post.data.date.valueOf()}
        data-title={sortKey(post.data.title)}
        data-read={post.data.date.valueOf()}
        data-published={'published' in post.data ? post.data.published : undefined}
        data-rating={'rating' in post.data && post.data.rating !== undefined ? post.data.rating : undefined}
        data-category={'category' in post.data ? post.data.category : undefined}
      >
        <a href={`/${post.collection}/${post.id}/`}>
          {/* Book covers are portrait; give them width only so nothing is cropped away. */}
          {post.collection === 'bookshelf' ? (
            <Image src={post.data.thumbnail} alt="" width={340} class="thumb contain" />
          ) : (
            <Image src={post.data.thumbnail} alt="" width={340} height={340} class="thumb" />
          )}
          <div>
            <h2>
              {post.data.title}
              {/* Rating and tags wrap as one unit, so a long title never strands a single tag. */}
              <span class="tags">
                {'published' in post.data && <Stars rating={post.data.rating} class="card-stars" />}
                {'category' in post.data && <span class="category">{post.data.category}</span>}
                {post.data.draft && <span class="status" data-status="Planned">Draft</span>}
              </span>
            </h2>
            <p class="meta">
              {byline(post)} · {formatDate(post.data.date)}
              {'published' in post.data && <> · published {formatYear(post.data.published)}</>}
            </p>
            <p class="excerpt">{post.data.excerpt}</p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

{/* Shown by SortFilter once more than a page of posts match. Without JS every post is listed. */}
<div class="more">
  <button id="show-more" type="button" hidden>
    Show more
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M3.5 6l4.5 4.5L12.5 6" />
    </svg>
  </button>
</div>

<style>
  .post-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--column);
    display: grid;
    gap: 1.5rem;
  }

  .more {
    max-width: var(--column);
    margin: 2.5rem auto 0;
    display: flex;
    justify-content: center;
  }

  /* Same thin chevron as the sort direction toggle, in a quiet outlined box. */
  #show-more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-size: 1.2rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--text);
    border-radius: 4px;
    padding: 0.85rem 2.75rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  #show-more[hidden] {
    display: none;
  }

  #show-more svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  #show-more:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  #show-more:hover svg {
    transform: translateY(2px);
  }

  #show-more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  a {
    display: flex;
    gap: 1.75rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  a:hover {
    box-shadow: var(--shadow);
  }

  .thumb {
    flex: none;
    width: 170px;
    height: 170px;
    object-fit: cover;
    border-radius: calc(var(--radius) - 2px);
  }

  /* Whole image inside the square, letterboxed rather than cropped. */
  .thumb.contain {
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(36, 26, 15, 0.22));
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: 1.55rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* A flex item of the title row: it drops below the title as a whole, and only wraps inside itself
     when it is wider than the card (on a phone). */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .meta {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  :global(.card-stars) {
    font-size: 1.15rem;
  }

  .category {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--rust-soft);
    color: var(--rust);
  }

  .excerpt {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    a {
      flex-direction: column;
      align-items: flex-start;
    }

    .thumb {
      width: 100%;
      height: 220px;
    }
  }
</style>
