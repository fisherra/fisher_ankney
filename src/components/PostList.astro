---
import { Image } from 'astro:assets';
import { byline, formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/${post.collection}/${post.id}/`}>
          <Image src={post.data.thumbnail} alt="" width={240} height={240} class="thumb" />
          <div>
            <h2>
              {post.data.title}
              {post.data.draft && <span class="status" data-status="Planned">Draft</span>}
            </h2>
            <p class="meta">
              {byline(post)} · {formatDate(post.data.date)}
            </p>
            <p class="excerpt">{post.data.excerpt}</p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 860px;
    display: grid;
    gap: 1.25rem;
  }

  a {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  a:hover {
    box-shadow: var(--shadow);
  }

  .thumb {
    flex: none;
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
  }

  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .excerpt {
    margin: 0;
  }

  @media (max-width: 560px) {
    a {
      flex-direction: column;
      align-items: flex-start;
    }

    .thumb {
      width: 100%;
      height: 180px;
    }
  }
</style>
