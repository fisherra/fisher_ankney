---
import { Image } from 'astro:assets';
import Stars from './Stars.astro';
import { byline, formatDate, formatYear, sortKey, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li
        data-title={sortKey(post.data.title)}
        data-read={post.data.date.valueOf()}
        data-published={'published' in post.data ? post.data.published : undefined}
        data-rating={'rating' in post.data && post.data.rating !== undefined ? post.data.rating : undefined}
        data-category={'category' in post.data ? post.data.category : undefined}
      >
        <a href={`/${post.collection}/${post.id}/`}>
          {/* Book covers are portrait; give them width only so nothing is cropped away. */}
          {post.collection === 'bookshelf' ? (
            <Image src={post.data.thumbnail} alt="" width={340} class="thumb contain" />
          ) : (
            <Image src={post.data.thumbnail} alt="" width={340} height={340} class="thumb" />
          )}
          <div>
            <h2>
              {post.data.title}
              {'category' in post.data && <span class="category">{post.data.category}</span>}
              {post.data.draft && <span class="status" data-status="Planned">Draft</span>}
            </h2>
            <p class="meta">
              {byline(post)} · {formatDate(post.data.date)}
              {'published' in post.data && <> · published {formatYear(post.data.published)}</>}
            </p>
            {'published' in post.data && <Stars rating={post.data.rating} class="card-stars" />}
            <p class="excerpt">{post.data.excerpt}</p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 960px;
    display: grid;
    gap: 1.5rem;
  }

  a {
    display: flex;
    gap: 1.75rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  a:hover {
    box-shadow: var(--shadow);
  }

  .thumb {
    flex: none;
    width: 170px;
    height: 170px;
    object-fit: cover;
    border-radius: calc(var(--radius) - 2px);
  }

  /* Whole image inside the square, letterboxed rather than cropped. */
  .thumb.contain {
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(36, 26, 15, 0.22));
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: 1.55rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .card-stars {
    display: block;
    margin: -0.2rem 0 0.6rem;
  }

  .category {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--rust-soft);
    color: var(--rust);
  }

  .excerpt {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    a {
      flex-direction: column;
      align-items: flex-start;
    }

    .thumb {
      width: 100%;
      height: 220px;
    }
  }
</style>
