---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Tag = project.url ? 'a' : 'div';

// 24×24 stroke icons, drawn in currentColor
const icons = {
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  hammer:
    '<g transform="translate(-1.75 1.75) rotate(45 12 12)"><rect x="5" y="3" width="14" height="5.5" rx="1.25"/><rect x="10.5" y="8.5" width="3" height="13" rx="1.5"/></g>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
};
---

<Tag class="card" id={project.id} href={project.url} data-theme={project.theme} data-photo={project.image && ''}>
  {project.image && <Image class="photo" src={project.image} widths={[480, 800]} sizes="(min-width: 860px) 400px, 100vw" alt="" />}
  <div class="top">
    <div class="icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={icons[project.icon]}
      />
    </div>
    <h3>{project.name}</h3>
    <span class="status" data-status={project.status}>{project.status}</span>
  </div>
  {project.tagline && <p class="tagline">{project.tagline}</p>}
  <p>{project.description}</p>
</Tag>

<style>
  .card {
    display: block;
    padding: 1.25rem 1.35rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    box-shadow: var(--shadow);
  }

  /* Per-project palettes: each theme sets the variables, these rules apply them */
  .card[data-theme] {
    color: var(--text);
  }

  a.card[data-theme]:hover {
    background: var(--surface-hover);
    border-color: var(--border-hover);
  }

  .card[data-theme] h3 {
    color: var(--heading);
  }

  .card[data-theme] .status {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* Build Buddy's own dark palette (build.fisherankney.com) */
  .card[data-theme='build-buddy'] {
    --surface: #1a1b1f;
    --surface-hover: #1e1f24;
    --border: #25262b;
    --border-hover: #34353b;
    --heading: #ececef;
    --text: #e6e6e8;
    --muted: #8e8f96;
    --accent: #a5a8ff;
    --accent-soft: rgba(123, 127, 240, 0.14);
    --scrim: linear-gradient(180deg, rgba(26, 27, 31, 0) 30%, rgba(26, 27, 31, 0.8) 72%, #1a1b1f 100%);
    --photo-position: 0% 0%;
    --shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  /* Fiddler's Friend's own forest-and-mint palette (fiddle.fisherankney.com), over the Callanish stones */
  .card[data-theme='fiddlers-fancy'] {
    --surface: #183825;
    --surface-hover: #183825;
    --border: #2f6544;
    --border-hover: #3e9a62;
    --heading: #ffffff;
    --text: #e8f3ea;
    --muted: #b3d1bc;
    --accent: #a3dbb0;
    --accent-soft: rgba(163, 219, 176, 0.16);
    --photo-position: 50% 58%;
    --scrim: linear-gradient(180deg, rgba(24, 56, 37, 0) 35%, rgba(24, 56, 37, 0.75) 72%, #183825 100%);
    --shadow: 0 2px 16px rgba(5, 40, 22, 0.35);
  }

  /* Photo cards: the image is a banner across the top that fades into the card's surface; the title sits on the fade. */
  .card[data-photo] {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: 6rem;
    padding-bottom: 1.6rem;
  }

  .card[data-photo] .photo {
    position: absolute;
    inset: 0 0 auto;
    z-index: -2;
    width: 100%;
    height: 9.5rem;
    object-fit: cover;
    object-position: var(--photo-position, 50% 50%);
    filter: saturate(0.8);
    transition: transform 0.4s ease;
  }

  .card[data-photo]::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 9.5rem;
    z-index: -1;
    background: var(--scrim);
  }

  a.card[data-photo]:hover .photo {
    transform: scale(1.03);
  }

  .card[data-photo] .icon {
    backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card[data-photo] .photo {
      transition: none;
    }
  }

  /* Gold on brushed silver */
  .card[data-theme='page-quest'] {
    --surface: linear-gradient(135deg, #f6f7f9, #dfe2e8);
    --surface-hover: linear-gradient(135deg, #fafbfc, #e6e9ee);
    --border: #c9a227;
    --border-hover: #b08a14;
    --heading: #1c1f24;
    --text: #2a2e35;
    --muted: #5b6270;
    --accent: #7a5c00;
    --accent-soft: #f1dd94;
    --photo-position: 50% 30%;
    --scrim: linear-gradient(180deg, rgba(240, 241, 245, 0) 35%, rgba(240, 241, 245, 0.8) 74%, #eff0f4 100%);
    --shadow: 0 2px 16px rgba(122, 92, 0, 0.18);
  }

  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* Icon, name and status share the top row; tagline and description run full width beneath. */
  .top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .top .status {
    margin-left: auto;
    flex-shrink: 0;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .tagline {
    margin: 0.9rem 0 0.5rem;
    color: var(--accent);
    font-weight: 600;
  }

  p {
    margin: 0;
  }

  /* No tagline: give the description the tagline's gap from the top row. */
  .top + p {
    margin-top: 0.9rem;
  }
</style>
