---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stars from './Stars.astro';
import { byline, formatDate, formatYear, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const sectionLabel = post.collection === 'journal' ? "Sportsman's Journal" : 'Bookshelf';
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article>
    <a class="back" href={`/${post.collection}/`}>← {sectionLabel}</a>
    <Image src={post.data.thumbnail} alt={post.data.title} width={800} class="cover" />
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        {byline(post)} · {formatDate(post.data.date)}
        {'published' in post.data && <> · published {formatYear(post.data.published)}</>}
      </p>
      {'published' in post.data && <Stars rating={post.data.rating} class="post-stars" />}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  article {
    max-width: var(--content);
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .back:hover {
    color: var(--text);
  }

  .cover {
    display: block;
    max-height: 480px;
    width: auto;
    margin: 0 auto 1.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  header {
    text-align: center;
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0 0 0.35rem;
    font-size: 2.1rem;
  }

  .meta {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .post-stars {
    margin-top: 0.6rem;
    font-size: 1.15rem;
  }
</style>
